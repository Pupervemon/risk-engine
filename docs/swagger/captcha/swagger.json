{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "HTTP endpoints for captcha generation, verification, health checks, and runtime image-source administration.",
        "title": "Captcha Service HTTP API",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/actuator/health": {
            "get": {
                "description": "Returns actuator-style health details, including dependency and disk probe status.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Detailed actuator health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.HealthResponseDoc"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.HealthResponseDoc"
                        }
                    }
                }
            }
        },
        "/actuator/health/liveness": {
            "get": {
                "description": "Returns a lightweight liveness status for platform probes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ProbeResponseDoc"
                        }
                    }
                }
            }
        },
        "/actuator/health/readiness": {
            "get": {
                "description": "Returns readiness status and dependency details for platform probes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Readiness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ReadinessResponseDoc"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ReadinessResponseDoc"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/image-source": {
            "get": {
                "description": "Returns the current Redis image source config, the active image pool source, and whether the pool is synced with the config.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Image Source Admin"
                ],
                "summary": "Get runtime image source status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authenticated user ID injected by the gateway",
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Authenticated role list injected by the gateway. Supports comma-separated values or JSON array. Must include 3 (admin).",
                        "name": "X-User-Roles",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceStatusDoc"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    }
                }
            },
            "put": {
                "description": "Checks a candidate image source, then persists it to Redis. The image pool uses it after a refresh.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Image Source Admin"
                ],
                "summary": "Update runtime image source config",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authenticated user ID injected by the gateway",
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Authenticated role list injected by the gateway. Supports comma-separated values or JSON array. Must include 3 (admin).",
                        "name": "X-User-Roles",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Runtime image source update payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceUpdateRequestDoc"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceStatusDoc"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceOperationErrorResponseDoc"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceOperationErrorResponseDoc"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceOperationErrorResponseDoc"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/image-source/check": {
            "post": {
                "description": "Checks the current Redis image source config by fetching one image without refreshing the pool.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Image Source Admin"
                ],
                "summary": "Check current image source config",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authenticated user ID injected by the gateway",
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Authenticated role list injected by the gateway. Supports comma-separated values or JSON array. Must include 3 (admin).",
                        "name": "X-User-Roles",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceValidationResultDoc"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/image-source/refresh": {
            "post": {
                "description": "Triggers an immediate refresh of the captcha image pool using the current Redis image source config.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Image Source Admin"
                ],
                "summary": "Refresh captcha image pool",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authenticated user ID injected by the gateway",
                        "name": "X-User-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Authenticated role list injected by the gateway. Supports comma-separated values or JSON array. Must include 3 (admin).",
                        "name": "X-User-Roles",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceStatusDoc"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/http.ImageSourceOperationErrorResponseDoc"
                        }
                    }
                }
            }
        },
        "/api/v1/captcha": {
            "get": {
                "description": "Returns a new slider captcha challenge, including master image, tile image, expiration, and whether mouse-track data is required.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Captcha"
                ],
                "summary": "Generate slider captcha",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.CaptchaChallengeResponseDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    }
                }
            }
        },
        "/api/v1/captcha/verify": {
            "post": {
                "description": "Verifies the slider position and optional mouse-track payload. On success, returns a short-lived captcha token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Captcha"
                ],
                "summary": "Verify slider captcha",
                "parameters": [
                    {
                        "description": "Captcha verification payload. mouseTrack should be supplied when requireMouseTrack=true.",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.VerifyCaptchaRequestDoc"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.VerifyCaptchaResponseDoc"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponseDoc"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns overall captcha service health and dependency status.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Service health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.HealthResponseDoc"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.HealthResponseDoc"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.ActiveImagePoolDoc": {
            "type": "object",
            "properties": {
                "imageCount": {
                    "type": "integer"
                },
                "refreshedAt": {
                    "type": "string"
                },
                "sourceConfigVersion": {
                    "type": "integer"
                },
                "sourceURL": {
                    "type": "string"
                }
            }
        },
        "http.CaptchaChallengeResponseDoc": {
            "type": "object",
            "properties": {
                "captchaId": {
                    "type": "string"
                },
                "expiresIn": {
                    "type": "integer"
                },
                "masterImage": {
                    "type": "string"
                },
                "requireMouseTrack": {
                    "type": "boolean"
                },
                "targetY": {
                    "type": "integer"
                },
                "tileImage": {
                    "type": "string"
                }
            }
        },
        "http.ErrorResponseDoc": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                }
            }
        },
        "http.HealthComponentDoc": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "http.HealthResponseDoc": {
            "type": "object",
            "properties": {
                "components": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/http.HealthComponentDoc"
                    }
                },
                "status": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "http.ImageSourceConfigDoc": {
            "type": "object",
            "properties": {
                "apiKeyConfigured": {
                    "type": "boolean"
                },
                "rateLimitPerMinute": {
                    "type": "integer"
                },
                "retryCount": {
                    "type": "integer"
                },
                "timeoutSeconds": {
                    "type": "integer"
                },
                "updatedAt": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                }
            }
        },
        "http.ImageSourceDebugDoc": {
            "type": "object",
            "properties": {
                "activeGeneration": {
                    "type": "string"
                },
                "generationCount": {
                    "type": "integer"
                }
            }
        },
        "http.ImageSourceOperationErrorResponseDoc": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/http.ImageSourceStatusDoc"
                }
            }
        },
        "http.ImageSourceOperationStatusDoc": {
            "type": "object",
            "properties": {
                "lastRefreshError": {
                    "type": "string"
                },
                "lastRefreshedAt": {
                    "type": "string"
                },
                "lastValidatedAt": {
                    "type": "string"
                },
                "lastValidationError": {
                    "type": "string"
                }
            }
        },
        "http.ImageSourceStatusDoc": {
            "type": "object",
            "properties": {
                "activePool": {
                    "$ref": "#/definitions/http.ActiveImagePoolDoc"
                },
                "config": {
                    "$ref": "#/definitions/http.ImageSourceConfigDoc"
                },
                "debug": {
                    "$ref": "#/definitions/http.ImageSourceDebugDoc"
                },
                "enabled": {
                    "type": "boolean"
                },
                "poolSize": {
                    "type": "integer"
                },
                "status": {
                    "$ref": "#/definitions/http.ImageSourceOperationStatusDoc"
                },
                "sync": {
                    "$ref": "#/definitions/http.ImageSourceSyncDoc"
                }
            }
        },
        "http.ImageSourceSyncDoc": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "poolSyncedWithConfig": {
                    "type": "boolean"
                }
            }
        },
        "http.ImageSourceUpdateRequestDoc": {
            "type": "object",
            "properties": {
                "apiKey": {
                    "type": "string"
                },
                "rateLimitPerMinute": {
                    "type": "integer"
                },
                "retryCount": {
                    "type": "integer"
                },
                "timeoutSeconds": {
                    "type": "integer"
                },
                "triggerRefresh": {
                    "type": "boolean"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "http.ImageSourceValidationResultDoc": {
            "type": "object",
            "properties": {
                "config": {
                    "$ref": "#/definitions/http.ImageSourceConfigDoc"
                },
                "validatedAt": {
                    "type": "string"
                }
            }
        },
        "http.ProbeResponseDoc": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "http.ReadinessResponseDoc": {
            "type": "object",
            "properties": {
                "components": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/http.HealthComponentDoc"
                    }
                },
                "status": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "http.TrackPointDoc": {
            "type": "object",
            "properties": {
                "t": {
