                },
                "x": {
                    "type": "integer"
                },
                "y": {
                    "type": "integer"
                }
            }
        },
        "http.VerifyCaptchaRequestDoc": {
            "type": "object",
            "properties": {
                "captchaId": {
                    "type": "string"
                },
                "mouseTrack": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.TrackPointDoc"
                    }
                },
                "pointX": {
                    "type": "integer"
                },
                "pointY": {
                    "type": "integer"
                }
            }
        },
        "http.VerifyCaptchaResponseDoc": {
            "type": "object",
            "properties": {
                "expiresIn": {
                    "type": "integer"
                },
                "token": {
                    "type": "string"
                }
            }
        }
    },
    "tags": [
        {
            "description": "Endpoints for generating and verifying slider captchas.",
            "name": "Captcha"
        },
        {
            "description": "Admin-only endpoints for runtime image-source management.",
            "name": "Image Source Admin"
        },
        {
            "description": "Service health and probe endpoints.",
            "name": "Health"
        }
    ]
}