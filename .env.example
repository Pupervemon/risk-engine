# Current config contract example
# Preferred keys use service prefixes:
# - RISK_*
# - CAPTCHA_*
# Global APP_ENV / CONFIG_FILE remain as fallback.

# ============================================
# Global fallback
# ============================================
APP_ENV=dev
# CONFIG_FILE=

# ============================================
# Risk service
# ============================================
# RISK_APP_ENV=dev
# RISK_CONFIG_FILE=./configs/risk.dev.yaml
# RISK_SERVER_HTTP_PORT=9080
# RISK_SERVER_GRPC_PORT=9090
# RISK_REDIS_ADDR=127.0.0.1:6379
# RISK_REDIS_PASSWORD=
# RISK_REDIS_DB=1
# RISK_REDIS_POOL_SIZE=50
# RISK_REDIS_DIAL_TIMEOUT_SECONDS=5
# RISK_REDIS_READ_TIMEOUT_SECONDS=3
# RISK_REDIS_WRITE_TIMEOUT_SECONDS=3
# RISK_REGISTRY_NACOS_ENABLE=false
# RISK_REGISTRY_NACOS_SERVER_ADDR=127.0.0.1:8848
# RISK_REGISTRY_NACOS_NAMESPACE=
# RISK_REGISTRY_NACOS_SERVICE_NAME=risk-service
# RISK_REGISTRY_NACOS_GROUP_NAME=DEFAULT_GROUP
# RISK_REGISTRY_NACOS_CLUSTER_NAME=dev-cluster
# RISK_REGISTRY_NACOS_REGISTER_IP=
# RISK_REGISTRY_NACOS_WEIGHT=1

# ============================================
# Captcha service
# ============================================
# CAPTCHA_APP_ENV=dev
# CAPTCHA_CONFIG_FILE=./configs/captcha.dev.yaml
# CAPTCHA_SERVER_HTTP_PORT=8091
# CAPTCHA_SERVER_GRPC_PORT=9091
# CAPTCHA_REDIS_ADDR=127.0.0.1:6379
# CAPTCHA_REDIS_PASSWORD=
# CAPTCHA_REDIS_DB=2
# CAPTCHA_REDIS_POOL_SIZE=10
# CAPTCHA_REDIS_DIAL_TIMEOUT_SECONDS=5
# CAPTCHA_REDIS_READ_TIMEOUT_SECONDS=3
# CAPTCHA_REDIS_WRITE_TIMEOUT_SECONDS=3
# CAPTCHA_TOKEN_SECRET=
# CAPTCHA_CAPTCHA_EXTERNAL_IMAGE_API_URL=
# CAPTCHA_CAPTCHA_EXTERNAL_IMAGE_API_API_KEY=
# CAPTCHA_REGISTRY_NACOS_ENABLE=false
# CAPTCHA_REGISTRY_NACOS_SERVER_ADDR=127.0.0.1:8848
# CAPTCHA_REGISTRY_NACOS_NAMESPACE=
# CAPTCHA_REGISTRY_NACOS_SERVICE_NAME=captcha-service
# CAPTCHA_REGISTRY_NACOS_GROUP_NAME=DEFAULT_GROUP
# CAPTCHA_REGISTRY_NACOS_CLUSTER_NAME=dev-cluster
# CAPTCHA_REGISTRY_NACOS_REGISTER_IP=
# CAPTCHA_REGISTRY_NACOS_WEIGHT=1

# ============================================
# Legacy compatibility aliases (deprecated)
# ============================================
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# NACOS_SERVER_ADDR=127.0.0.1:8848
# NACOS_NAMESPACE=
# NACOS_ENABLE=false
# TOKEN_SECRET=

# --------------------------------------------
# Legacy notes retained below temporarily while
# repo docs are being normalized.
# --------------------------------------------
# 环境变量示例文件
# 复制此文件为 .env 并根据实际情况修改
# 注意：.env 文件不应提交到版本控制系统

# ============================================
# 环境标识
# ============================================
# 可选值：dev | prod
# APP_ENV=dev

# ============================================
# Redis 配置（可选，会覆盖配置文件中的值）
# ============================================
# Redis 服务器地址
# REDIS_ADDR=127.0.0.1:6379

# Redis 密码（生产环境必须设置）
# REDIS_PASSWORD=your_secure_password

# Redis 数据库编号
# REDIS_DB=0

# ============================================
# Nacos 配置（可选）
# ============================================
# Nacos 服务器地址
# NACOS_SERVER_ADDR=127.0.0.1:8848

# Nacos 命名空间
# NACOS_NAMESPACE=dev

# 是否启用 Nacos 服务注册（true/false）
# NACOS_ENABLE=false

# ============================================
# Captcha Token 配置（可选）
# ============================================
# Token 密钥（生产环境必须设置）
# TOKEN_SECRET=your_secret_key_min_32_chars

# ============================================
# 使用示例
# ============================================
# 
# 开发环境（Windows PowerShell）:
#   $env:APP_ENV="dev"
#   go run cmd/risk-server/main.go
#
# 生产环境（Linux/Mac）:
#   export APP_ENV=prod
#   export REDIS_PASSWORD=secure_password
#   ./risk-server
#
# Docker:
#   docker run -e APP_ENV=prod -e REDIS_PASSWORD=secure_password risk-server
#
