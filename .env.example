# 环境变量示例文件
# 复制此文件为 .env 并根据实际情况修改
# 注意：.env 文件不应提交到版本控制系统

# ============================================
# 环境标识
# ============================================
# 可选值：dev | prod
APP_ENV=dev

# ============================================
# Redis 配置（可选，会覆盖配置文件中的值）
# ============================================
# Redis 服务器地址
# REDIS_ADDR=127.0.0.1:6379

# Redis 密码（生产环境必须设置）
# REDIS_PASSWORD=your_secure_password

# Redis 数据库编号
# REDIS_DB=0

# ============================================
# Nacos 配置（可选）
# ============================================
# Nacos 服务器地址
# NACOS_SERVER_ADDR=127.0.0.1:8848

# Nacos 命名空间
# NACOS_NAMESPACE=dev

# 是否启用 Nacos 服务注册（true/false）
# NACOS_ENABLE=false

# ============================================
# Captcha Token 配置（可选）
# ============================================
# Token 密钥（生产环境必须设置）
# TOKEN_SECRET=your_secret_key_min_32_chars

# ============================================
# 使用示例
# ============================================
# 
# 开发环境（Windows PowerShell）:
#   $env:APP_ENV="dev"
#   go run cmd/risk-server/main.go
#
# 生产环境（Linux/Mac）:
#   export APP_ENV=prod
#   export REDIS_PASSWORD=secure_password
#   ./risk-server
#
# Docker:
#   docker run -e APP_ENV=prod -e REDIS_PASSWORD=secure_password risk-server
#
